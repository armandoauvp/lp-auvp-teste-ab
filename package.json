{
  "name": "lp-auvp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Páginas da AUVP: institucional e LP da Escola, publicadas juntas",
  "workspaces": [
    "institucional",
    "escola"
  ],
  "scripts": {
    "dev": "npm run dev -w institucional",
    "dev:escola": "npm run dev -w escola",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test ab/*.test.js scripts/*.test.mjs && npm test -w escola",
    "typecheck": "npm run typecheck -w institucional",
    "lint": "npm run lint -w institucional",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "edge:build": "node scripts/build-edge.mjs",
    "esquadro": "node scripts/esquadro.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=22"
  }
}
